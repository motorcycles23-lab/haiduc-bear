  <script>
    window.addEventListener("load", () => {
      /* ============================================================
         0. HELPERE GENERALE
         ============================================================ */
      function escapeHtml(value) {
        return String(value == null ? "" : value)
          .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
      }

      function debounce(fn, delay) {
        let timer = null;
        return (...args) => {
          clearTimeout(timer);
          timer = setTimeout(() => fn(...args), delay);
        };
      }

      function isValidImageUrl(u) {
        return typeof u === "string" && /^data:image\/(png|jpe?g|webp|gif);base64,/i.test(u);
      }

      function isValidSighting(b) {
        return !!b &&
          typeof b.location === "string" && b.location.trim().length > 0 &&
          Number.isFinite(b.lat) && b.lat >= -90 && b.lat <= 90 &&
          Number.isFinite(b.lng) && b.lng >= -180 && b.lng <= 180 &&
          Number.isFinite(b.timestamp) && b.timestamp > 0;
