<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Haiduc Bear — Hartă Montană & Monitorizare Urși</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      overflow: hidden;
      font-family: "Inter", system-ui, -apple-system, sans-serif;
    }
    .bear-pulse {
      animation: bearPulseAnim 1.8s infinite;
    }
    @keyframes bearPulseAnim {
      0% { transform: scale(0.95); opacity: 0.7; }
      70% { transform: scale(1.65); opacity: 0; }
      100% { transform: scale(1.65); opacity: 0; }
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-900">
  <!-- Container principal hartă Leaflet -->
  <div id="map" class="fixed inset-0 z-0 w-full h-full"></div>

  <!-- Banner alertă proximitate urs (< 1 km) -->
  <div id="proximityBanner" class="hidden fixed top-24 left-1/2 -translate-x-1/2 z-[650] bg-red-600/95 backdrop-blur-md text-white px-4 py-2.5 rounded-2xl shadow-2xl border border-red-300/40 flex items-center gap-3 max-w-md w-[calc(100%-24px)]">
    <span class="text-xl shrink-0">⚠️</span>
    <div class="flex-1 text-xs font-bold leading-snug">
      <div class="uppercase tracking-wider text-[10px] text-red-100">Alertă proximitate GPS</div>
      <div id="proximityBannerText"></div>
    </div>
    <button type="button" id="closeProximityBannerBtn" class="w-7 h-7 rounded-full bg-white/20 hover:bg-white/30 text-white font-bold text-xs flex items-center justify-center shrink-0">✕</button>
  </div>

  <!-- Bara de sus (Căutare + Filtre + Acțiuni rapide) -->
  <div class="fixed top-3 left-3 right-3 z-[500] flex flex-col gap-2 pointer-events-none">
    <div class="flex items-center justify-between gap-2 flex-wrap">
      <!-- Caseta de căutare & Sigla HAIDUC BEAR -->
      <div class="pointer-events-auto flex items-center bg-white/95 backdrop-blur-md rounded-2xl shadow-lg border border-slate-200/90 px-2.5 py-1.5 gap-2 w-full sm:w-auto sm:min-w-[340px] max-w-md">
        <button type="button" id="openBrandLogoBtn" title="Emblema oficială Haiduc Bear" class="w-10 h-10 rounded-full overflow-hidden shrink-0 border-2 border-[#f3efe2] shadow-md hover:scale-105 transition bg-[#172e1f] flex items-center justify-center">
          <svg viewBox="0 0 120 120" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
            <circle cx="60" cy="60" r="59" fill="#f3efe2"/>
            <circle cx="60" cy="60" r="54" fill="#183021" stroke="#8c7a53" stroke-width="3" stroke-dasharray="4 2.5"/>
            <path d="M12,60 A48,48 0 0,1 108,60 Z" fill="#cbe5e8"/>
            <polygon points="54,58 72,30 86,44 96,28 108,58" fill="#7c9685"/>
            <polygon points="72,30 78,39 71,38 66,43" fill="#ffffff"/>
            <path d="M52,60 Q78,44 108,58 L104,68 L52,68 Z" fill="#4f8a45"/>
            <path d="M62,67 Q84,61 95,53 Q82,58 72,67 Z" fill="#c79e6b"/>
            <path d="M22,68 C19,49 24,33 32,27 C30,22 33,18 37,20 C41,19 46,19 50,20 C54,18 57,22 55,27 C62,34 66,50 64,68 Z" fill="#231912"/>
            <path d="M24,68 C22,51 26,36 34,29 C32,24 34,21 37,22 C41,21 46,21 50,22 C53,21 55,24 53,29 C60,36 63,51 61,68 Z" fill="#7c5638"/>
            <ellipse cx="43.5" cy="28" rx="10.5" ry="9.5" fill="#8e6544"/>
            <ellipse cx="43.5" cy="30.5" rx="4.5" ry="3.8" fill="#d9c09c"/>
            <circle cx="43.5" cy="29.2" r="2" fill="#1c1510"/>
            <circle cx="39.5" cy="26.5" r="1.2" fill="#1c1510"/>
            <circle cx="47.5" cy="26.5" r="1.2" fill="#1c1510"/>
            <path d="M35,38 Q43.5,45 52,38 Q48,50 43.5,52 Q39,50 35,38 Z" fill="#183021"/>
            <path d="M12,62 L108,62 A48,48 0 0,1 12,62 Z" fill="#183021"/>
            <text x="60" y="83" text-anchor="middle" fill="#f5f2e8" font-family="Inter, sans-serif" font-weight="900" font-size="21" letter-spacing="0.5">HAIDUC</text>
            <text x="60" y="99" text-anchor="middle" fill="#f5f2e8" font-family="Inter, sans-serif" font-weight="800" font-size="13" letter-spacing="1.2">BEAR</text>
            <circle cx="60" cy="109" r="4.5" fill="#d99b52"/>
          </svg>
        </button>

        <button type="button" id="toggleDrawerBtn" title="Deschide/Ascunde panoul" class="p-2 rounded-xl hover:bg-slate-100 text-slate-700 font-bold transition">
          ☰
        </button>

        <input id="searchInput" type="text" placeholder="Caută traseu, vârf, refugiu sau zonă..." class="w-full bg-transparent text-sm text-slate-800 placeholder-slate-400 focus:outline-none" />
        <button type="button" id="clearSearchBtn" class="hidden text-xs text-slate-400 hover:text-slate-700 px-1.5 font-bold">✕</button>
      </div>

      <!-- Butoane dreapta-sus: Ghid, Trimite GPS, Alarmă, SOS 112, Salvamont -->
      <div class="pointer-events-auto flex items-center gap-1.5 flex-wrap">
        <button type="button" id="openGuideBtn" class="bg-white/95 hover:bg-emerald-50 text-emerald-900 border border-emerald-200 px-3 py-2 rounded-2xl shadow-md text-xs font-extrabold flex items-center gap-1.5 transition">
          <span>🛡️</span>
          <span>Ghid</span>
        </button>

        <button type="button" id="shareGpsBtn" class="bg-white/95 hover:bg-sky-50 text-sky-900 border border-sky-200 px-3 py-2 rounded-2xl shadow-md text-xs font-extrabold flex items-center gap-1.5 transition" title="Trimite coordonatele GPS pe WhatsApp sau copiază">
          <span>📤</span>
          <span class="hidden md:inline">Trimite GPS</span>
        </button>

        <button type="button" id="bearAlarmBtn" class="bg-amber-500 hover:bg-amber-600 text-white px-3 py-2 rounded-2xl shadow-md text-xs font-extrabold flex items-center gap-1.5 transition" title="Semnal acustic puternic anti-urs">
          <span>🔊</span>
          <span class="hidden sm:inline">Alarmă</span>
        </button>

        <a href="tel:112" class="bg-red-600 hover:bg-red-700 text-white px-3.5 py-2 rounded-2xl shadow-md text-xs font-extrabold flex items-center gap-1.5 transition">
          <span>📞</span>
          <span>112</span>
        </a>

        <a href="tel:0725826668" class="bg-orange-500 hover:bg-orange-600 text-white px-3.5 py-2 rounded-2xl shadow-md text-xs font-extrabold flex items-center gap-1.5 transition" title="Dispecerat Național Salvamont (0SALVAMONT)">
          <span>⛰️</span>
          <span>Salvamont</span>
        </a>
      </div>
    </div>

    <!-- Rândul 2: Chip-uri de filtrare rapide -->
    <div class="pointer-events-auto flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-0.5">
      <button type="button" data-filter="all" class="filter-chip active bg-[#143624] text-white border border-[#143624] px-3 py-1.5 rounded-full text-xs font-bold shadow-sm whitespace-nowrap transition">
        Toate
      </button>
      <button type="button" data-filter="24h" class="filter-chip bg-white/95 text-slate-700 border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-full text-xs font-bold shadow-sm whitespace-nowrap transition">
        🕒 Ultimele 24h
      </button>
      <button type="button" data-filter="high" class="filter-chip bg-white/95 text-slate-700 border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-full text-xs font-bold shadow-sm whitespace-nowrap transition">
        🔴 Risc ridicat
      </button>
      <button type="button" data-filter="trails" class="filter-chip bg-white/95 text-slate-700 border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-full text-xs font-bold shadow-sm whitespace-nowrap transition">
        🥾 Doar trasee
      </button>
      <button type="button" data-filter="shelters" class="filter-chip bg-white/95 text-slate-700 border border-slate-200 hover:bg-slate-50 px-3 py-1.5 rounded-full text-xs font-bold shadow-sm whitespace-nowrap transition">
        🏠 Refugii (16)
      </button>
    </div>
  </div>

  <!-- Panou lateral stânga (Trasee Carpați, Semnalări Urși, Refugii Alpine) -->
  <aside id="sideDrawer" class="fixed top-28 bottom-14 left-3 z-[450] w-[calc(100%-24px)] sm:w-[370px] bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl border border-slate-200/90 flex flex-col overflow-hidden transition-transform duration-300">
    <!-- Tab-uri navigare -->
    <div class="grid grid-cols-3 border-b border-slate-200 bg-slate-50/90 p-1.5 gap-1 shrink-0">
      <button type="button" data-tab="trails" class="drawer-tab active bg-[#143624] text-white py-2 px-2 rounded-2xl text-xs font-extrabold transition">
        🥾 Trasee (<span id="trailsTabCount">25</span>)
      </button>
      <button type="button" data-tab="bears" class="drawer-tab text-slate-600 hover:bg-white py-2 px-2 rounded-2xl text-xs font-extrabold transition">
        🐻 Urși (<span id="bearsTabCount">0</span>)
      </button>
      <button type="button" data-tab="shelters" class="drawer-tab text-slate-600 hover:bg-white py-2 px-2 rounded-2xl text-xs font-extrabold transition">
        🏠 Refugii (<span id="sheltersTabCount">16</span>)
      </button>
    </div>

    <!-- Conținut Tab Trasee -->
    <div id="tabContentTrails" class="flex-1 overflow-y-auto p-3 space-y-2.5">
      <div class="flex items-center justify-between gap-2">
        <select id="massifFilterSelect" class="w-full bg-slate-100 border border-slate-200 rounded-xl px-2.5 py-1.5 text-xs font-bold text-slate-800 focus:outline-none">
          <option value="all">Toți munții (Bucegi, Făgăraș, Piatra Craiului, Postăvaru, Ciucaș, Ceahlău)</option>
          <option value="Bucegi">Munții Bucegi</option>
          <option value="Făgăraș">Munții Făgăraș (Moldoveanu, Negoiu, Podragu)</option>
          <option value="Piatra Craiului">Munții Piatra Craiului</option>
          <option value="Postăvaru">Masivul Postăvaru</option>
          <option value="Ciucaș">Masivul Ciucaș (Muntele Roșu)</option>
          <option value="Ceahlău">Masivul Ceahlău</option>
        </select>
      </div>
      <div id="trailsListContainer" class="space-y-2"></div>

      <!-- Card detalii traseu selectat -->
      <div id="selectedTrailDetailsCard" class="hidden p-3 rounded-2xl border border-emerald-300 bg-emerald-50/90 space-y-2">
        <div class="flex items-start justify-between gap-2">
          <div id="selectedTrailTitle" class="font-extrabold text-xs text-emerald-950 leading-snug"></div>
          <button type="button" id="closeSelectedTrailBtn" class="text-xs font-bold text-emerald-800 hover:text-emerald-950 px-1">✕</button>
        </div>
        <div id="selectedTrailMeta" class="flex flex-wrap gap-1.5 text-[11px] font-semibold text-emerald-900"></div>
        <div class="flex items-center gap-2 pt-1">
          <button type="button" id="centerSelectedTrailBtn" class="flex-1 py-1.5 px-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white text-[11px] font-bold transition">
            🎯 Centrează traseu
          </button>
          <button type="button" id="reportOnSelectedTrailBtn" class="py-1.5 px-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-[11px] font-bold transition">
            🐻 Alertă pe traseu
          </button>
        </div>
      </div>
    </div>

    <!-- Conținut Tab Semnalări Urși -->
    <div id="tabContentBears" class="hidden flex-1 overflow-y-auto p-3 space-y-2.5">
      <div class="flex items-center justify-between bg-amber-50 border border-amber-200 rounded-2xl p-2.5">
        <div class="text-xs text-amber-900 font-semibold">
          Ai văzut un urs sau urme proaspete pe traseu?
        </div>
        <button type="button" id="openReportModalFromTabBtn" class="bg-red-600 hover:bg-red-700 text-white text-xs font-extrabold px-3 py-1.5 rounded-xl shrink-0 shadow">
          + Semnalează
        </button>
      </div>
      <div id="bearsListContainer" class="space-y-2"></div>
    </div>

    <!-- Conținut Tab Refugii & Cabane -->
    <div id="tabContentShelters" class="hidden flex-1 overflow-y-auto p-3 space-y-2.5">
      <div class="bg-sky-50 border border-sky-200 rounded-2xl p-2.5 text-xs text-sky-900 font-medium">
        Refugii alpine de urgență și cabane montane cu adăpost și contact rapid. Apasă pe oricare pentru centrare pe hartă.
      </div>
      <div>
        <select id="shelterMassifFilterSelect" class="w-full bg-slate-100 border border-slate-200 rounded-xl px-2.5 py-1.5 text-xs font-bold text-slate-800 focus:outline-none">
          <option value="all">Toate refugiile și cabanele (16)</option>
          <option value="Bucegi">Munții Bucegi</option>
          <option value="Făgăraș">Munții Făgăraș</option>
          <option value="Piatra Craiului">Munții Piatra Craiului</option>
          <option value="Postăvaru">Masivul Postăvaru</option>
          <option value="Ceahlău">Masivul Ceahlău</option>
        </select>
      </div>
      <div id="sheltersListContainer" class="space-y-2"></div>
    </div>
  </aside><!-- Butoane plutitoare dreapta-jos: Straturi hartă, Busolă, Lanternă SOS, Locație GPS, Semnalează Urs -->
  <div class="fixed bottom-4 right-3 z-[500] flex flex-col items-end gap-2">
    <!-- Selector straturi hartă -->
    <div class="bg-white/95 backdrop-blur-md rounded-2xl shadow-lg border border-slate-200 p-1 flex items-center gap-1">
      <button type="button" data-layer="street" class="map-layer-btn active bg-[#143624] text-white px-2.5 py-1.5 rounded-xl text-[11px] font-bold transition">Implicit</button>
      <button type="button" data-layer="satellite" class="map-layer-btn text-slate-700 hover:bg-slate-100 px-2.5 py-1.5 rounded-xl text-[11px] font-bold transition">Satelit</button>
      <button type="button" data-layer="terrain" class="map-layer-btn text-slate-700 hover:bg-slate-100 px-2.5 py-1.5 rounded-xl text-[11px] font-bold transition">Teren</button>
    </div>

    <div class="flex items-center gap-2">
      <!-- Busolă montană -->
      <button type="button" id="openCompassBtn" title="Busolă montană live" class="w-11 h-11 rounded-2xl bg-white/95 hover:bg-slate-50 text-slate-800 border border-slate-200 shadow-lg flex items-center justify-center text-lg font-bold transition">
        🧭
      </button>

      <!-- Lanternă SOS Morse -->
      <button type="button" id="openSosFlashlightBtn" title="Lanternă SOS Morse pe ecran" class="h-11 px-3 rounded-2xl bg-slate-900 hover:bg-black text-amber-300 border border-slate-700 shadow-lg flex items-center justify-center gap-1 text-xs font-extrabold transition">
        <span>🔦</span>
        <span>SOS</span>
      </button>

      <!-- Locație GPS + Verificare proximitate -->
      <button type="button" id="locateMeBtn" title="Poziția mea GPS & Alertă proximitate urs" class="w-11 h-11 rounded-2xl bg-white/95 hover:bg-sky-50 text-sky-700 border border-slate-200 shadow-lg flex items-center justify-center text-lg font-bold transition">
        📍
      </button>

      <!-- Buton principal Semnalează Urs -->
      <button type="button" id="openReportModalBtn" class="h-11 px-4 rounded-2xl bg-red-600 hover:bg-red-700 text-white shadow-xl font-extrabold text-xs sm:text-sm flex items-center gap-2 transition active:scale-95">
        <span>🐻</span>
        <span>Semnalează Urs</span>
      </button>
    </div>
  </div>

  <!-- Insignă discretă jos-stânga/centru: Powered by haiduc -->
  <div class="fixed bottom-2.5 left-1/2 -translate-x-1/2 z-[400] pointer-events-none hidden sm:flex items-center gap-2 bg-slate-900/90 backdrop-blur-md text-white/95 px-3.5 py-1.5 rounded-full border border-white/20 shadow-lg text-[11px] font-medium">
    <span class="text-white/75">Powered by</span>
    <span class="inline-flex flex-col items-center justify-center bg-black/95 border border-white/25 rounded-lg px-2 py-0.5 leading-none shadow-inner">
      <svg width="22" height="22" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Copac Haiduc">
        <!-- Coroana bogată a copacului -->
        <path d="M50 12 C42 12 37 18 33 21 C25 21 20 27 21 34 C14 37 12 45 18 51 C15 57 21 63 29 61 C34 64 42 63 50 58 C58 63 66 64 71 61 C79 63 85 57 82 51 C88 45 86 37 79 34 C80 27 75 21 67 21 C63 18 58 12 50 12 Z" fill="#e5e7eb"/>
        <!-- Trunchi și ramuri interioare -->
        <path d="M46 66 L47 32 L34 23 M48 44 L63 31 M52 50 L68 44 M46 48 L30 39" stroke="#0f172a" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M45 68 L55 68 L53 45 L47 45 Z" fill="#f1f5f9"/>
        <!-- Rădăcini răsfirate -->
        <path d="M46 67 L35 76 L24 81 M48 68 L41 79 L36 86 M50 68 L50 82 M52 68 L59 79 L65 86 M54 67 L66 76 L77 81" stroke="#f1f5f9" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span style="font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 700; font-size: 9px; letter-spacing: 0.4px; color: #f8fafc; margin-top: 1px;">haiduc</span>
    </span>
  </div>

  <!-- Toast / Mesaj status (fără alert()) -->
  <div id="toastMessage" class="hidden fixed bottom-20 left-1/2 -translate-x-1/2 z-[950] bg-slate-900/95 text-white text-xs font-semibold px-4 py-2.5 rounded-2xl shadow-xl border border-white/15 max-w-sm text-center"></div>

  <!-- Modal Semnalare Urs -->
  <div id="reportModal" class="hidden fixed inset-0 z-[900] bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full shadow-2xl overflow-hidden border border-slate-200">
      <div class="bg-[#143624] text-white px-5 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-xl">🐻</span>
          <h3 class="font-extrabold text-base">Semnalează Prezență Urs</h3>
        </div>
        <button type="button" id="closeReportModalBtn" class="w-8 h-8 rounded-full bg-white/15 hover:bg-white/25 flex items-center justify-center font-bold">✕</button>
      </div>
      <form id="bearReportForm" class="p-5 space-y-3.5">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Zonă / Traseu montan</label>
          <input id="reportLocationName" type="text" required placeholder="Ex: Jepii Mici, Valea Cerbului, Podragu..." class="w-full border border-slate-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-emerald-700" />
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Tip observație</label>
            <select id="reportType" class="w-full border border-slate-300 rounded-xl px-2.5 py-2 text-xs font-semibold">
              <option value="Urs pe potecă">Urs pe potecă</option>
              <option value="Ursoaică cu pui">Ursoaică cu pui (Pericol maxim)</option>
              <option value="Urme proaspete / Bârlog">Urme proaspete</option>
              <option value="Urs lângă cabană / refugiu">Urs lângă cabană / refugiu</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Nivel de risc</label>
            <select id="reportSeverity" class="w-full border border-slate-300 rounded-xl px-2.5 py-2 text-xs font-semibold">
              <option value="high">🔴 Risc ridicat</option>
              <option value="medium">🟠 Risc mediu</option>
              <option value="low">🟡 Observație la distanță</option>
            </select>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-xs font-bold text-slate-700">Coordonate GPS (sau clic pe hartă)</label>
            <button type="button" id="pickMapCoordsBtn" class="text-[11px] font-bold text-emerald-700 hover:underline">📍 Folosește centrul hărții</button>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <input id="reportLat" type="number" step="0.0001" required placeholder="Latitudine" class="w-full border border-slate-300 rounded-xl px-3 py-1.5 text-xs" />
            <input id="reportLng" type="number" step="0.0001" required placeholder="Longitudine" class="w-full border border-slate-300 rounded-xl px-3 py-1.5 text-xs" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Detalii pentru alți drumeți</label>
          <textarea id="reportNotes" rows="2" placeholder="Ex: S-a retras spre pădure, păstrați distanța și faceți zgomot..." class="w-full border border-slate-300 rounded-xl px-3 py-2 text-xs focus:outline-none focus:border-emerald-700"></textarea>
        </div>

        <button type="submit" class="w-full py-3 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-extrabold text-sm shadow-lg transition">
          Publică alerta pe hartă
        </button>
      </form>
    </div>
  </div>

  <!-- Modal Ghid Siguranță & Checklist Echipament Montan -->
  <div id="guideModal" class="hidden fixed inset-0 z-[900] bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full max-h-[88vh] flex flex-col shadow-2xl overflow-hidden border border-slate-200">
      <div class="bg-[#143624] text-white px-5 py-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <span class="text-xl">🛡️</span>
          <h3 class="font-extrabold text-base">Ghid Siguranță & Rucsac Montan</h3>
        </div>
        <button type="button" id="closeGuideModalBtn" class="w-8 h-8 rounded-full bg-white/15 hover:bg-white/25 flex items-center justify-center font-bold">✕</button>
      </div>
      <div class="p-5 overflow-y-auto space-y-4 text-xs text-slate-700 leading-relaxed">
        <div class="bg-red-50 border border-red-200 rounded-2xl p-3.5 space-y-1.5">
          <div class="font-extrabold text-red-900 text-sm">🐻 Reguli esențiale la întâlnirea cu ursul:</div>
