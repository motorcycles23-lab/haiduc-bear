        const km = computePolylineKm(trail.coords);
        const card = document.getElementById("selectedTrailDetailsCard");
        const titleEl = document.getElementById("selectedTrailTitle");
        const metaEl = document.getElementById("selectedTrailMeta");
        if (card && titleEl && metaEl) {
