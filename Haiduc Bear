      }

      document.getElementById("openReportModalBtn").addEventListener("click", () => openReportModal());
      document.getElementById("openReportModalFromTabBtn").addEventListener("click", () => openReportModal());
      document.getElementById("closeReportModalBtn").addEventListener("click", () => reportModal.classList.add("hidden"));
      document.getElementById("pickMapCoordsBtn").addEventListener("click", () => {
