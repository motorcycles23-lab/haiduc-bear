      }

      function renderAllMapData() {
        renderTrails();
        renderShelters();
        renderBears();
      }

      /* ============================================================
         11. VERIFICARE PROXIMITATE GPS (< 1 km față de un urs semnalat)
         ============================================================ */
      function checkBearProximity(lat, lng) {
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
        let closest = null;
        let minDist = Infinity;
        bearSightings.forEach((b) => {
          const d = distanceKm(lat, lng, b.lat, b.lng);
          if (d < minDist) {
            minDist = d;
            closest = b;
          }
        });
        const banner = document.getElementById("proximityBanner");
        const bannerText = document.getElementById("proximityBannerText");
        if (closest && minDist <= 1.0) {
          bannerText.textContent = `${closest.type} (${closest.location}) la ${(minDist * 1000).toFixed(0)} m de tine!`;
          banner.classList.remove("hidden");
        } else {
          banner.classList.add("hidden");
        }
      }

      document.getElementById("closeProximityBannerBtn").addEventListener("click", () => {
        document.getElementById("proximityBanner").classList.add("hidden");
      });

      function checkProximityFromGps() {
        if (!("geolocation" in navigator)) return;
        navigator.geolocation.getCurrentPosition(
          (pos) => checkBearProximity(pos.coords.latitude, pos.coords.longitude),
          () => {},
          { enableHighAccuracy: true, timeout: 8000, maximumAge: 60000 }
        );
      }

