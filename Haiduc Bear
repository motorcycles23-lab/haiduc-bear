        document.getElementById("reportLat").value = c.lat.toFixed(4);
        document.getElementById("reportLng").value = c.lng.toFixed(4);
      });

      map.on("click", (e) => {
        document.getElementById("reportLat").value = e.latlng.lat.toFixed(4);
