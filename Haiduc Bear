      /* ============================================================
         13. FORMULAR SEMNALARE URS (validat) + CLIC PE HARTĂ
         ============================================================ */
      const reportModal = document.getElementById("reportModal");

      function openReportModal(lat, lng) {
        const center = lat != null && lng != null ? { lat, lng } : map.getCenter();
        document.getElementById("reportLat").value = center.lat.toFixed(4);
        document.getElementById("reportLng").value = center.lng.toFixed(4);
