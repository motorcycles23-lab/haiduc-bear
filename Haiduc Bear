      /* ============================================================
         10. RANDARE SEMNALĂRI URȘI (input utilizator escapat)
         ============================================================ */
      function renderBears() {
        bearsGroup.clearLayers();
        const container = document.getElementById("bearsListContainer");
        container.innerHTML = "";

        const showBearsOnMap = activeFilter === "all" || activeFilter === "24h" || activeFilter === "high";
        const filtered = bearSightings.filter((b) => {
          if (activeFilter === "24h" && Date.now() - b.timestamp > 24 * 3600 * 1000) return false;
          if (activeFilter === "high" && b.severity !== "high") return false;
          if (searchQuery && !b.location.toLowerCase().includes(searchQuery) && !b.type.toLowerCase().includes(searchQuery)) return false;
          return true;
        });

        document.getElementById("bearsTabCount").textContent = filtered.length;

        filtered.forEach((bear) => {
          const sev = bear.severity === "high" || bear.severity === "medium" ? bear.severity : "low";
          const ringColor = sev === "high" ? "bg-red-600" : sev === "medium" ? "bg-amber-500" : "bg-yellow-500";
          const bearType = escapeHtml(bear.type);
          const bearLoc = escapeHtml(bear.location);
          const bearNotes = escapeHtml(bear.notes || "Atenție sporită pe traseu.");

          if (showBearsOnMap) {
            const icon = L.divIcon({
              className: "",
              html: `
                <div class="relative w-9 h-9 flex items-center justify-center">
                  <span class="bear-pulse absolute inset-0 rounded-full ${ringColor} opacity-50"></span>
                  <div class="relative w-8 h-8 rounded-full ${ringColor} text-white border-2 border-white shadow-lg flex items-center justify-center text-sm">🐻</div>
                </div>
              `,
              iconSize: [36, 36],
              iconAnchor: [18, 18]
            });

            L.marker([bear.lat, bear.lng], { icon })
              .addTo(bearsGroup)
              .bindPopup(`
                <div class="text-xs space-y-1 min-w-[190px]">
                  <div class="font-extrabold text-red-700 text-sm">🐻 ${bearType}</div>
                  <div class="font-bold text-slate-900">${bearLoc}</div>
                  <div class="text-slate-500">${formatTimeAgo(bear.timestamp)} · ${bear.lat.toFixed(4)}, ${bear.lng.toFixed(4)}</div>
                  <div class="text-slate-700 pt-1">${bearNotes}</div>
                </div>
              `);
          }

          const card = document.createElement("div");
          card.className = "p-2.5 rounded-2xl border border-slate-200 bg-white hover:border-red-300 cursor-pointer transition shadow-sm";
          card.innerHTML = `
            <div class="flex items-start justify-between gap-2">
              <div class="font-extrabold text-xs text-slate-900">🐻 ${bearLoc}</div>
