        showToast(`Coordonate selectate: ${e.latlng.lat.toFixed(4)}, ${e.latlng.lng.toFixed(4)}`);
      });

      document.getElementById("bearReportForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const location = document.getElementById("reportLocationName").value.trim();
        const lat = parseFloat(document.getElementById("reportLat").value);
        const lng = parseFloat(document.getElementById("reportLng").value);
        const notes = document.getElementById("reportNotes").value.trim();

        if (!location) {
          showToast("Completează zona / traseul.");
          return;
        }
        if (!Number.isFinite(lat) || lat < -90 || lat > 90 || !Number.isFinite(lng) || lng < -180 || lng > 180) {
          showToast("Coordonate GPS invalide. Alege poziția pe hartă.");
          return;
        }

        const newSighting = {
          id: "b-" + Date.now(),
          location,
          type: document.getElementById("reportType").value,
          severity: document.getElementById("reportSeverity").value,
          lat, lng, notes,
          timestamp: Date.now()
        };
        bearSightings.unshift(newSighting);
        saveBearSightings();
        renderBears();
        reportModal.classList.add("hidden");
        document.getElementById("bearReportForm").reset();
        map.setView([newSighting.lat, newSighting.lng], 14);
        showToast("Alerta de urs a fost publicată pe hartă!");

        if (userGpsCoords) checkBearProximity(userGpsCoords.lat, userGpsCoords.lng);
      });

      /* ============================================================
         14. LOCALIZARE GPS LIVE & TRIMITERE COORDONATE PE WHATSAPP
         ============================================================ */
      document.getElementById("locateMeBtn").addEventListener("click", () => {
        if (!("geolocation" in navigator)) {
          showToast("Dispozitivul nu suportă localizarea GPS.");
          return;
        }
        showToast("Se caută semnalul GPS...");
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const { latitude, longitude } = pos.coords;
            userGpsCoords = { lat: latitude, lng: longitude };
            if (userGpsMarker) map.removeLayer(userGpsMarker);
            userGpsMarker = L.circleMarker([latitude, longitude], {
              radius: 9,
              fillColor: "#0284c7",
              color: "#ffffff",
              weight: 3,
              fillOpacity: 1
            }).addTo(map).bindPopup("Poziția ta GPS actuală");
            map.setView([latitude, longitude], 14);
            checkBearProximity(latitude, longitude);
            showToast(`GPS activ: ${latitude.toFixed(4)}, ${longitude.toFixed(4)}`);
          },
          () => showToast("Nu s-a putut accesa GPS-ul. Verifică permisiunile."),
          { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
        );
      });

      function copyText(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
        } else {
          fallbackCopy(text);
        }
      }

      function fallbackCopy(text) {
        const tempInput = document.createElement("textarea");
        tempInput.value = text;
        tempInput.style.position = "fixed";
        tempInput.style.opacity = "0";
        document.body.appendChild(tempInput);
        tempInput.select();
        try { document.execCommand("copy"); } catch (err) {}
        document.body.removeChild(tempInput);
      }

      document.getElementById("shareGpsBtn").addEventListener("click", () => {
        const pt = userGpsCoords || map.getCenter();
        let nearestShelter = SHELTERS_DATA[0];
        let bestDist = Infinity;
        SHELTERS_DATA.forEach((s) => {
          const d = distanceKm(pt.lat, pt.lng, s.lat, s.lng);
          if (d < bestDist) {
            bestDist = d;
            nearestShelter = s;
          }
        });

        const msg = `Haiduc Bear — Poziția mea montană:\nLat: ${pt.lat.toFixed(5)}, Lng: ${pt.lng.toFixed(5)}\nGoogle Maps: https://maps.google.com/?q=${pt.lat.toFixed(5)},${pt.lng.toFixed(5)}\nCel mai apropiat refugiu: ${nearestShelter.name} (${bestDist.toFixed(1)} km)`;
        copyText(msg);
        showToast("Coordonatele GPS au fost copiate! Se deschide WhatsApp...");
        window.open(`https://wa.me/?text=${encodeURIComponent(msg)}`, "_blank");
      });

      /* ============================================================
         15. ALARMĂ ACUSTICĂ ANTI-URS (Web Audio API — fără fișiere externe)
         ============================================================ */
      let alarmActive = false;
      let alarmInterval = null;
      let audioCtx = null;
      const bearAlarmBtn = document.getElementById("bearAlarmBtn");

      bearAlarmBtn.addEventListener("click", () => {
        if (alarmActive) {
          alarmActive = false;
          clearInterval(alarmInterval);
          alarmInterval = null;
          if (audioCtx) audioCtx.suspend();
          bearAlarmBtn.classList.remove("animate-pulse", "bg-red-600");
          bearAlarmBtn.classList.add("bg-amber-500");
          showToast("Alarma acustică a fost oprită.");
          return;
        }
        try {
          audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
          if (audioCtx.state === "suspended") audioCtx.resume();
          alarmActive = true;
          bearAlarmBtn.classList.remove("bg-amber-500");
          bearAlarmBtn.classList.add("animate-pulse", "bg-red-600");
          showToast("Alarmă acustică anti-urs PORNITĂ!");

          const playBeep = () => {
            if (!alarmActive) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = "sawtooth";
            osc.frequency.setValueAtTime(880, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(1480, audioCtx.currentTime + 0.25);
            gain.gain.setValueAtTime(0.35, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.28);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.28);
          };
          playBeep();
          alarmInterval = setInterval(playBeep, 420);
        } catch (err) {
          console.warn("Haiduc Bear: audio indisponibil.", err);
          showToast("Audio indisponibil în acest browser.");
        }
      });

      // Alarma se suspendă temporar când tabul e pe fundal — nu mai sună în continuu
      document.addEventListener("visibilitychange", () => {
        if (!audioCtx) return;
        if (document.hidden) {
          audioCtx.suspend();
        } else if (alarmActive) {
          audioCtx.resume();
        }
      });

      /* ============================================================
         16. GHID & CHECKLIST RUCSAC MONTAN
         ============================================================ */
      const GEAR_ITEMS = [
        "Spray cu piper special pentru urs (la îndemână)",
        "Fluier de urgență & Frontală cu baterii de rezervă",
        "Folie de supraviețuire izotermă",
        "Baterie externă încărcată + cablu telefon",
        "Minim 2L apă + batoane energizante",
        "Pelerină de ploaie / geacă impermeabilă",
        "Trusă mică de prim-ajutor"
      ];
      const CHECKLIST_KEY = "haiduc_bear_gear_checklist_v1";
      let checkedGear = {};
      try {
        const saved = JSON.parse(localStorage.getItem(CHECKLIST_KEY) || "{}");
        if (saved && typeof saved === "object") checkedGear = saved;
      } catch (err) {
        console.warn("Haiduc Bear: checklistul salvat nu a putut fi citit.", err);
      }

      function renderGearChecklist() {
        const container = document.getElementById("gearChecklistContainer");
        container.innerHTML = "";
        let count = 0;
        GEAR_ITEMS.forEach((item, idx) => {
          const isChecked = !!checkedGear[idx];
          if (isChecked) count++;
          const label = document.createElement("label");
          label.className = "flex items-center gap-2.5 p-2 rounded-xl bg-white border border-emerald-200/80 cursor-pointer hover:bg-emerald-100/40";
          label.innerHTML = `
            <input type="checkbox" ${isChecked ? "checked" : ""} class="w-4 h-4 accent-emerald-700 rounded" />
            <span class="${isChecked ? "line-through text-slate-400" : "text-slate-800 font-medium"}">${escapeHtml(item)}</span>
          `;
          label.querySelector("input").addEventListener("change", (e) => {
            checkedGear[idx] = e.target.checked;
            try { localStorage.setItem(CHECKLIST_KEY, JSON.stringify(checkedGear)); } catch (err) {
              console.warn("Haiduc Bear: salvarea checklistului a eșuat.", err);
            }
            renderGearChecklist();
          });
          container.appendChild(label);
        });
        document.getElementById("checklistProgress").textContent = `${count}/${GEAR_ITEMS.length} pregătite`;
      }

      const guideModal = document.getElementById("guideModal");
      document.getElementById("openGuideBtn").addEventListener("click", () => {
        renderGearChecklist();
        guideModal.classList.remove("hidden");
      });
      document.getElementById("closeGuideModalBtn").addEventListener("click", () => guideModal.classList.add("hidden"));

      /* ============================================================
         17. BUSOLĂ MONTANĂ LIVE (cu permisiune iOS 13+)
         ============================================================ */
      const compassModal = document.getElementById("compassModal");
      const compassNeedle = document.getElementById("compassNeedle");
      const compassHeadingText = document.getElementById("compassHeadingText");
      const manualCompassSlider = document.getElementById("manualCompassSlider");

      function updateCompassDisplay(deg) {
        const d = ((Math.round(Number(deg) || 0) % 360) + 360) % 360;
        const dirs = ["N", "NE", "E", "SE", "S", "SV", "V", "NV"];
        const card = dirs[Math.round(d / 45) % 8];
        compassNeedle.style.transform = `rotate(${-d}deg)`;
        compassHeadingText.textContent = `${d}° ${card}`;
      }

      manualCompassSlider.addEventListener("input", (e) => updateCompassDisplay(e.target.value));

      window.addEventListener("deviceorientation", (e) => {
        if (typeof e.alpha === "number") {
          const heading = e.webkitCompassHeading || (360 - e.alpha);
          updateCompassDisplay(heading);
        }
        // pe desktop alpha rămâne undefined — sliderul manual rămâne fallback
      });

      document.getElementById("openCompassBtn").addEventListener("click", async () => {
        compassModal.classList.remove("hidden");
        try {
          // iOS 13+ cere permisiune explicită, declanșată de gestul utilizatorului
          if (typeof DeviceOrientationEvent !== "undefined" &&
              typeof DeviceOrientationEvent.requestPermission === "function") {
            const res = await DeviceOrientationEvent.requestPermission();
            if (res !== "granted") {
              showToast("Permisiunea pentru busolă a fost refuzată. Folosește sliderul manual.");
            }
          }
        } catch (err) {
          showToast("Busola pe senzor nu e disponibilă aici — folosește sliderul manual.");
        }
      });
      document.getElementById("closeCompassModalBtn").addEventListener("click", () => compassModal.classList.add("hidden"));

      /* ============================================================
         18. LANTERNĂ SOS MORSE (··· −−− ···)
         ============================================================ */
      const sosOverlay = document.getElementById("sosFlashlightOverlay");
      let sosTimer = null;
      const MORSE_PATTERN = [
        { on: true, ms: 200 }, { on: false, ms: 150 },
        { on: true, ms: 200 }, { on: false, ms: 150 },
        { on: true, ms: 200 }, { on: false, ms: 350 },
        { on: true, ms: 550 }, { on: false, ms: 150 },
        { on: true, ms: 550 }, { on: false, ms: 150 },
        { on: true, ms: 550 }, { on: false, ms: 350 },
        { on: true, ms: 200 }, { on: false, ms: 150 },
        { on: true, ms: 200 }, { on: false, ms: 150 },
        { on: true, ms: 200 }, { on: false, ms: 900 }
      ];

      function runSosStep(idx) {
        if (sosOverlay.classList.contains("hidden")) return;
        const step = MORSE_PATTERN[idx % MORSE_PATTERN.length];
        sosOverlay.style.backgroundColor = step.on ? "#ffffff" : "#000000";
        sosTimer = setTimeout(() => runSosStep(idx + 1), step.ms);
      }

      document.getElementById("openSosFlashlightBtn").addEventListener("click", () => {
        sosOverlay.classList.remove("hidden");
        runSosStep(0);
      });
      document.getElementById("stopSosFlashlightBtn").addEventListener("click", () => {
        clearTimeout(sosTimer);
        sosOverlay.classList.add("hidden");
      });

      /* ============================================================
         19. COPERTĂ OFICIALĂ & POZĂ OFICIALĂ HAIDUC BEAR (validată)
         ============================================================ */
      const COVER_STORAGE_KEY = "haiduc_bear_official_cover_v1";
      const splashScreen = document.getElementById("appSplashScreen");
      const splashBackdrop = document.getElementById("splashBackdrop");
      const defaultAppCoverSvg = document.getElementById("defaultAppCoverSvg");
      const splashCenterBadge = document.getElementById("splashCenterBadge");
      const openBrandLogoBtn = document.getElementById("openBrandLogoBtn");
      const brandLogoModal = document.getElementById("brandLogoModal");
      const brandBadgePreview = document.getElementById("brandBadgePreview");
      const defaultHeaderSvg = openBrandLogoBtn.innerHTML;
      const defaultModalSvg = brandBadgePreview.innerHTML;

      function applyOfficialImage(dataUrl) {
        if (!isValidImageUrl(dataUrl)) return;
        if (splashBackdrop) splashBackdrop.style.backgroundImage = `url("${dataUrl}")`;
        if (defaultAppCoverSvg) defaultAppCoverSvg.style.display = "none";
        if (splashCenterBadge) splashCenterBadge.style.display = "none";
        if (openBrandLogoBtn) {
          openBrandLogoBtn.innerHTML = `<img src="${escapeHtml(dataUrl)}" alt="Haiduc Bear" class="w-full h-full object-cover" />`;
        }
        if (brandBadgePreview) {
          brandBadgePreview.innerHTML = `<img src="${escapeHtml(dataUrl)}" alt="Haiduc Bear" class="w-full h-full object-cover" />`;
        }
      }

      function resetOfficialImage() {
        try { localStorage.removeItem(COVER_STORAGE_KEY); } catch (err) {}
        if (splashBackdrop) splashBackdrop.style.backgroundImage = "";
        if (defaultAppCoverSvg) defaultAppCoverSvg.style.display = "block";
        if (splashCenterBadge) splashCenterBadge.style.display = "flex";
        if (openBrandLogoBtn) openBrandLogoBtn.innerHTML = defaultHeaderSvg;
        if (brandBadgePreview) brandBadgePreview.innerHTML = defaultModalSvg;
        showToast("S-a revenit la emblema implicită Haiduc Bear.");
      }

      try {
        const savedCover = localStorage.getItem(COVER_STORAGE_KEY);
        if (savedCover && isValidImageUrl(savedCover)) applyOfficialImage(savedCover);
      } catch (err) {
        console.warn("Haiduc Bear: coperta salvată nu a putut fi citită.", err);
      }

      function handleImageFileSelect(file) {
        if (!file) return;
        if (!/^image\/(png|jpe?g|webp|gif)$/.test(file.type)) {
          showToast("Formate acceptate: .jpg, .png, .webp.");
          return;
        }
        const reader = new FileReader();
        reader.onload = (ev) => {
          const result = ev.target && ev.target.result;
          if (typeof result === "string" && isValidImageUrl(result)) {
            applyOfficialImage(result);
            try { localStorage.setItem(COVER_STORAGE_KEY, result); } catch (err) {
              console.warn("Haiduc Bear: salvarea imaginii a eșuat (probabil prea mare).", err);
              showToast("Imaginea e prea mare pentru a fi salvată permanent.");
            }
            showToast("Imaginea Haiduc Bear a fost actualizată!");
          } else {
            showToast("Imaginea nu a putut fi procesată.");
          }
        };
        reader.readAsDataURL(file);
      }

      document.getElementById("splashPhotoUploadInput").addEventListener("change", (e) => {
        handleImageFileSelect(e.target.files && e.target.files[0]);
      });
      document.getElementById("customBrandLogoInput").addEventListener("change", (e) => {
        handleImageFileSelect(e.target.files && e.target.files[0]);
      });
      document.getElementById("resetBrandLogoBtn").addEventListener("click", resetOfficialImage);
      document.getElementById("enterAppBtn").addEventListener("click", () => {
        splashScreen.classList.add("hidden");
        setTimeout(() => map.invalidateSize(), 100);
      });
      openBrandLogoBtn.addEventListener("click", () => splashScreen.classList.remove("hidden"));
      document.getElementById("closeBrandLogoModalBtn").addEventListener("click", () => brandLogoModal.classList.add("hidden"));

      /* ============================================================
         20. INIȚIALIZARE COMPLETĂ
         ============================================================ */
      renderAllMapData();

      // Verificare proximitate urs și la pornirea aplicației
      checkProximityFromGps();
    });
  </script>
</body>
</html>
